# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.a
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Mac
.DS_Store

# R package folder and related files
*.R
*.rda

# Shell configuration files
*.bashrc
*.zshrc

# LBFGSB files
code/lbfgsb

# example files
example/

# compiled program files -- these patterns match at any depth, so they also
# keep the build output in bin/ out of git while the run-*.sh scripts next to
# it stay tracked. Do not ignore bin/ itself: new scripts added there would be
# silently left out.
cnets
cnetml
cnetmcmc

# workspace files
cneta.code-workspace

# vscode
.vscode/

# Jetbrains
.idea/

# Build directory (also covers the CMake-generated CMakeCache.txt,
# CMakeFiles/, cmake_install.cmake, and Makefile within it — build.sh
# always configures out-of-source here, never in code/ or docs/)
code/build/
build/

# Python test tooling
__pycache__/
.pytest_cache/
.venv/
